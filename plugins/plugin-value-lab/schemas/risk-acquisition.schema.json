{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PVL prospective risk-controlled acquisition",
  "description": "Frozen utility, risk, independent-unit sampling and budgets. Runtime verifies assignments, matched inputs, history, uncertainty and costs. Conditional statistical certification is not scientific acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "protocol_sha256",
    "batches"
  ],
  "properties": {
    "protocol": {
      "$ref": "#/$defs/protocol"
    },
    "protocol_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "batches": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plan",
          "result"
        ],
        "properties": {
          "plan": {
            "$ref": "#/$defs/plan"
          },
          "result": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/record"
                }
              }
            ]
          }
        }
      }
    },
    "assumption_violations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    }
  },
  "$defs": {
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "catalog_sha256",
        "task_sha256",
        "objective",
        "bound",
        "alpha",
        "epsilon",
        "quality_floor",
        "allocation",
        "candidates",
        "baseline_id",
        "max_units_per_candidate",
        "batch_units",
        "runs_per_unit",
        "budget_micros",
        "max_total_units",
        "population",
        "utility_contract",
        "assumptions",
        "evidence_type"
      ],
      "properties": {
        "format": {
          "const": "pvl-risk-acquisition-1"
        },
        "catalog_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "task_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "objective": {
          "const": "epsilon_optimal_above_floor_v1"
        },
        "bound": {
          "const": "hoeffding_candidate_horizon_union_v1"
        },
        "alpha": {
          "type": "number",
          "minimum": 1e-8,
          "maximum": 0.25
        },
        "epsilon": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "quality_floor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "allocation": {
          "enum": [
            "adaptive_frontier",
            "uniform_all"
          ]
        },
        "candidates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "plan_sha256",
              "unit_cost_cap_micros"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
              },
              "plan_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "unit_cost_cap_micros": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000000
              }
            }
          }
        },
        "baseline_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
        },
        "max_units_per_candidate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "batch_units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "runs_per_unit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "budget_micros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000000
        },
        "max_total_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3200000
        },
        "population": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "sampling_unit",
            "sampling_rule",
            "distribution_sha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "sampling_unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "sampling_rule": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "distribution_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "utility_contract": {
          "type": "object",
          "minProperties": 1
        },
        "assumptions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bounded_utility",
            "independent_units",
            "stationary_population",
            "predictable_assignment"
          ],
          "properties": {
            "bounded_utility": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "independent_units": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "stationary_population": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "predictable_assignment": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "evidence_type": {
          "enum": [
            "synthetic",
            "submitted_observations"
          ]
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_sha256",
        "history_sha256",
        "index",
        "candidate_ids",
        "unit_ids",
        "planned_candidate_units",
        "planned_runs",
        "reserved_micros"
      ],
      "properties": {
        "protocol_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "history_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "candidate_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "unit_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "planned_candidate_units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "planned_runs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 81920000
        },
        "reserved_micros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000000000000
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "unit_id",
        "input_sha256",
        "session_id",
        "assessment_sha256",
        "utility_contract_sha256",
        "status",
        "utility",
        "cost_micros",
        "runs_started"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
        },
        "unit_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
        },
        "assessment_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "utility_contract_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "observed",
            "failed",
            "unknown"
          ]
        },
        "utility": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "cost_micros": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000000000000
        },
        "runs_started": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    }
  }
}
