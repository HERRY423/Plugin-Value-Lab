{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PVL local decision append request",
  "description": "Input to DecisionStore.append / local append CLI. Artifact digests may be supplied only for bytes already retained; --artifact supplies new bytes atomically. This schema does not verify transitions, spending or scientific validity. New writes use pvl-decision-store-2; v1 histories are read without rewriting. Runtime checks enforce retry ancestry, reconciliation identity and unchanged observations for rescore. Explanation events judge/decide/review/present use format 3; v1/v2 events retain their original semantics. Current guidance is a lifecycle projection, not an authority or scientific validity claim.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "payload",
        "key",
        "expected_sequence"
      ],
      "properties": {
        "kind": {
          "const": "initialize"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "plan": {
              "type": "object",
              "minProperties": 1
            },
            "plan_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "required_evidence": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,200}$"
              }
            },
            "dependencies": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "budget_micros": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "plan",
            "plan_sha256",
            "required_evidence",
            "dependencies",
            "budget_micros"
          ]
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "expected_sequence": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
