{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "answers"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "answers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision",
          "result",
          "rationale"
        ],
        "properties": {
          "decision": {
            "enum": [
              "allow",
              "withhold"
            ]
          },
          "result": {
            "type": "object",
            "minProperties": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
