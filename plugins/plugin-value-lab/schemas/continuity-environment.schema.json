{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Submitted current environment for a retained decision checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "checkpoint", "dependencies", "judgments", "decisions", "host"],
  "properties": {
    "format": {"const": "pvl-continuity-environment-1"},
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "sequence", "head_sha256", "plan_sha256"],
      "properties": {
        "format": {"const": "pvl-decision-checkpoint-1"},
        "sequence": {"type": "integer", "minimum": 1},
        "head_sha256": {"$ref": "#/$defs/sha"},
        "plan_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "dependencies": {"type": "object", "additionalProperties": {"$ref": "#/$defs/identity"}},
    "judgments": {"type": "object", "additionalProperties": {
      "type": "object", "additionalProperties": false, "required": ["contract", "implementation"],
      "properties": {
        "contract": {
          "type": "object", "additionalProperties": false, "required": ["grader", "reference", "domain"],
          "properties": {
            "grader": {"$ref": "#/$defs/nonemptyObject"},
            "reference": {"$ref": "#/$defs/nonemptyObject"},
            "domain": {"$ref": "#/$defs/nonemptyObject"}
          }
        },
        "implementation": {"$ref": "#/$defs/identity"}
      }
    }},
    "decisions": {"type": "object", "additionalProperties": {
      "type": "object", "additionalProperties": false, "required": ["policy", "scope", "host_requirements"],
      "properties": {
        "policy": {
          "type": "object", "additionalProperties": false, "required": ["purpose", "quality_thresholds", "budget_micros"],
          "properties": {
            "purpose": {"type": "string", "pattern": "\\S"},
            "quality_thresholds": {"$ref": "#/$defs/nonemptyObject"},
            "budget_micros": {"type": ["integer", "null"], "minimum": 0}
          }
        },
        "scope": {"$ref": "#/$defs/nonemptyObject"},
        "host_requirements": {"type": "object", "additionalProperties": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        }}
      }
    }},
    "host": {"oneOf": [{"type": "null"}, {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot", "receipt", "receipt_sha256", "expected_session_id", "expected_prefix_sha256"],
      "properties": {
        "snapshot": {"type": "object"},
        "receipt": {"type": ["object", "null"]},
        "receipt_sha256": {"type": ["string", "null"]},
        "expected_session_id": {"type": "string", "minLength": 1},
        "expected_prefix_sha256": {"$ref": "#/$defs/sha"}
      }
    }]}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "identity": {"type": ["string", "null"], "pattern": "\\S"},
    "nonemptyObject": {"type": "object", "minProperties": 1}
  }
}
