# Run in a fresh working directory with counts.h5ad and settings.json.
# Use --keep-incomplete to retain failure reports for diagnosis.
INPUT = config.get("input", "counts.h5ad")
SETTINGS = config.get("settings", "settings.json")
RESULT = config.get("output", "snakemake-result")

rule all:
    input:
        RESULT

rule aggregate:
    input:
        counts=INPUT,
        settings=SETTINGS
    output:
        directory(RESULT)
    threads: 1
    resources:
        mem_mb=1024
    run:
        from value_lab.core import load_json
        from value_lab.sdk import aggregate_counts, verify_run
        result = aggregate_counts(input.counts, output=output[0], **load_json(input.settings))
        verify_run(result.directory, expected_id=result.commitment)
