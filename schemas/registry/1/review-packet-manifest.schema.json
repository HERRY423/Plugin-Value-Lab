{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "entry_id", "files"],
  "properties": {
    "format": {"const": "pvl-review-packet-1"},
    "entry_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "files": {
      "type": "object",
      "required": ["study/manifest.json", "review-history.json"],
      "propertyNames": {"pattern": "^(study/.+|review-history\\.json)$"},
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    }
  }
}
