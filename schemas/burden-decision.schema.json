{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pvl-burden-decision-1",
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "scope",
        "local_only",
        "incumbent_plan_sha256",
        "metrics"
      ],
      "properties": {
        "objective": {
          "enum": [
            "human_seconds",
            "cash_usd",
            "elapsed_seconds",
            "new_plugins",
            "total_plugins",
            "pareto"
          ]
        },
        "scope": {
          "const": "one_complete_frozen_task_no_amortization"
        },
        "local_only": {
          "type": "boolean"
        },
        "incumbent_plan_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "human_seconds",
            "cash_usd",
            "elapsed_seconds",
            "new_plugins",
            "total_plugins"
          ],
          "properties": {
            "human_seconds": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "material_delta",
                "max_value"
              ],
              "properties": {
                "material_delta": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000000.0
                },
                "max_value": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000000000000.0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "cash_usd": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "material_delta",
                "max_value"
              ],
              "properties": {
                "material_delta": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000000.0
                },
                "max_value": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000000000000.0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "elapsed_seconds": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "material_delta",
                "max_value"
              ],
              "properties": {
                "material_delta": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000000.0
                },
                "max_value": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000000000000.0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "new_plugins": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "material_delta",
                "max_value"
              ],
              "properties": {
                "material_delta": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000000.0
                },
                "max_value": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000000000000.0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "total_plugins": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "material_delta",
                "max_value"
              ],
              "properties": {
                "material_delta": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000000.0
                },
                "max_value": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000000000000.0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "suite": {
      "type": "object",
      "required": [
        "id",
        "cases",
        "conditions",
        "policy",
        "task_selection",
        "runs_per_case",
        "evidence_type"
      ]
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "source_sha256"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "timer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "phase",
        "actor",
        "start",
        "end",
        "source_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "phase": {
          "enum": [
            "setup",
            "execution",
            "review",
            "rework",
            "pvl_prepare",
            "pvl_verify",
            "pvl_report",
            "pvl_false_positive",
            "pvl_recovery"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "cash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "phase",
        "amount_usd",
        "basis",
        "source_sha256",
        "line_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "phase": {
          "enum": [
            "setup",
            "execution",
            "review",
            "rework",
            "pvl_prepare",
            "pvl_verify",
            "pvl_report",
            "pvl_false_positive",
            "pvl_recovery"
          ]
        },
        "amount_usd": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000.0
            },
            {
              "type": "null"
            }
          ]
        },
        "basis": {
          "enum": [
            "settled",
            "estimate",
            "unknown"
          ]
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "line_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setup",
        "execution",
        "review",
        "rework",
        "pvl_prepare",
        "pvl_verify",
        "pvl_report",
        "pvl_false_positive",
        "pvl_recovery"
      ],
      "properties": {
        "setup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "human",
            "cash",
            "note"
          ],
          "properties": {
            "human": {
              "enum": [
                "complete",
                "not_applicable",
                "unknown"
              ]
            },
            "cash": {
              "enum": [
                "complete",
                "not_applicable",
                "unknown"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "human",
            "cash",
            "note"
          ],
          "properties": {
            "human": {
              "enum": [
                "complete",
                "not_applicable",
                "unknown"
              ]
            },
            "cash": {
              "enum": [
                "complete",
                "not_applicable",
                "unknown"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "human",
            "cash",
            "note"
          ],
          "properties": {
            "human": {
              "enum": [
                "complete",
                "not_applicable",
                "unknown"
              ]
            },
            "cash": {
              "enum": [
                "complete",
                "not_applicable",
                "unknown"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        },
        "rework": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "human",
            "cash",
            "note"
          ],
          "properties": {
            "human": {
              "enum": [
                "complete",
                "not_applicable",
                "unknown"
              ]
            },
            "cash": {
              "enum": [
                "complete",
                "not_applicable",
                "unknown"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        },
        "pvl_prepare": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "human",
            "cash",
            "note"
          ],
          "properties": {
            "human": {
              "enum": [
                "complete",
                "not_applicable",
                "unknown"
              ]
            },
            "cash": {
              "enum": [
                "complete",
                "not_applicable",
                "unknown"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        },
        "pvl_verify": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "human",
            "cash",
            "note"
          ],
          "properties": {
            "human": {
              "enum": [
                "complete",
                "not_applicable",
                "unknown"
              ]
            },
            "cash": {
              "enum": [
                "complete",
                "not_applicable",
                "unknown"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        },
        "pvl_report": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "human",
            "cash",
            "note"
          ],
          "properties": {
            "human": {
              "enum": [
                "complete",
                "not_applicable",
                "unknown"
              ]
            },
            "cash": {
              "enum": [
                "complete",
                "not_applicable",
                "unknown"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        },
        "pvl_false_positive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "human",
            "cash",
            "note"
          ],
          "properties": {
            "human": {
              "enum": [
                "complete",
                "not_applicable",
                "unknown"
              ]
            },
            "cash": {
              "enum": [
                "complete",
                "not_applicable",
                "unknown"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        },
        "pvl_recovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "human",
            "cash",
            "note"
          ],
          "properties": {
            "human": {
              "enum": [
                "complete",
                "not_applicable",
                "unknown"
              ]
            },
            "cash": {
              "enum": [
                "complete",
                "not_applicable",
                "unknown"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window",
        "timers",
        "cash",
        "coverage"
      ],
      "properties": {
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/window"
            },
            {
              "type": "null"
            }
          ]
        },
        "timers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/timer"
          },
          "maxItems": 10000
        },
        "cash": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cash"
          },
          "maxItems": 10000
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer",
        "source_sha256",
        "note"
      ],
      "properties": {
        "status": {
          "enum": [
            "accepted",
            "rejected",
            "unknown"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_sha256",
        "protocol_sha256",
        "records_sha256",
        "components_sha256",
        "locality",
        "reviews"
      ],
      "properties": {
        "plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "protocol_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "records_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "components_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "locality": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "source_sha256",
            "note"
          ],
          "properties": {
            "status": {
              "enum": [
                "satisfied",
                "violated",
                "unknown"
              ]
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        },
        "reviews": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/review"
          }
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite_sha256",
        "arm",
        "repetition",
        "records_sha256",
        "protocol_sha256",
        "resources"
      ],
      "properties": {
        "suite_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "arm": {
          "enum": [
            "with",
            "without"
          ]
        },
        "repetition": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "records_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "protocol_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    },
    "overhead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_sha256",
        "observations_sha256",
        "resources"
      ],
      "properties": {
        "protocol_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "observations_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "catalog_sha256",
        "task_sha256",
        "candidate_plan_sha256s",
        "policy",
        "study_suites"
      ],
      "properties": {
        "format": {
          "const": "pvl-burden-decision-1"
        },
        "catalog_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "task_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidate_plan_sha256s": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "maxItems": 256
        },
        "policy": {
          "$ref": "#/$defs/policy"
        },
        "study_suites": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/suite"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "policy",
        "study_suites"
      ],
      "properties": {
        "action": {
          "const": "prepare"
        },
        "policy": {
          "$ref": "#/$defs/policy"
        },
        "study_suites": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/suite"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "protocol",
        "protocol_sha256",
        "receipts",
        "assurances",
        "decision_overhead"
      ],
      "properties": {
        "action": {
          "const": "analyze"
        },
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "protocol_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "receipts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/receipt"
          },
          "maxItems": 3200
        },
        "assurances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assurance"
          },
          "maxItems": 256
        },
        "decision_overhead": {
          "anyOf": [
            {
              "$ref": "#/$defs/overhead"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  ]
}
