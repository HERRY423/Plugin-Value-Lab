{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PVL prospective risk-controlled acquisition",
  "description": "Frozen utility, risk, independent-unit sampling and budgets. Runtime verifies assignments, matched inputs, history, uncertainty and costs. Conditional statistical certification is not scientific acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "protocol_sha256",
    "batches"
  ],
  "properties": {
    "protocol": {
      "$ref": "#/$defs/protocol"
    },
    "protocol_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "batches": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plan",
          "result"
        ],
        "properties": {
          "plan": {
            "$ref": "#/$defs/plan"
          },
          "result": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/record"
                }
              }
            ]
          }
        }
      }
    },
    "assumption_violations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "confirmation_studies": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object"
      },
      "description": "Raw task-selection study bundles; runtime recomputes v3, independence and candidate alpha, never accepts passed flags."
    }
  },
  "$defs": {
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "catalog_sha256",
        "task_sha256",
        "objective",
        "bound",
        "alpha",
        "epsilon",
        "quality_floor",
        "allocation",
        "candidates",
        "baseline_id",
        "max_units_per_candidate",
        "batch_units",
        "runs_per_unit",
        "budget_micros",
        "max_total_units",
        "population",
        "utility_contract",
        "assumptions",
        "evidence_type"
      ],
      "properties": {
        "format": {
          "enum": [
            "pvl-risk-acquisition-1",
            "pvl-risk-acquisition-2"
          ]
        },
        "catalog_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "task_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "objective": {
          "const": "epsilon_optimal_above_floor_v1"
        },
        "bound": {
          "const": "hoeffding_candidate_horizon_union_v1"
        },
        "alpha": {
          "type": "number",
          "minimum": 1e-08,
          "maximum": 0.25
        },
        "epsilon": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "quality_floor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "allocation": {
          "enum": [
            "adaptive_frontier",
            "uniform_all",
            "round_robin"
          ]
        },
        "candidates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "plan_sha256",
              "unit_cost_cap_micros"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
              },
              "plan_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "unit_cost_cap_micros": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000000
              }
            }
          }
        },
        "baseline_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
        },
        "max_units_per_candidate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "batch_units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "runs_per_unit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "budget_micros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000000
        },
        "max_total_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3200000
        },
        "population": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "sampling_unit",
            "sampling_rule",
            "distribution_sha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "sampling_unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "sampling_rule": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "distribution_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "utility_contract": {
          "type": "object",
          "minProperties": 1
        },
        "assumptions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bounded_utility",
            "independent_units",
            "stationary_population",
            "predictable_assignment"
          ],
          "properties": {
            "bounded_utility": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "independent_units": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "stationary_population": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "predictable_assignment": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "no_order_or_carryover": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "evidence_type": {
          "enum": [
            "synthetic",
            "submitted_observations"
          ]
        },
        "decision_policy": {
          "$ref": "#/$defs/decision_policy"
        },
        "rotation_seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "pvl-risk-acquisition-2"
              }
            }
          },
          "then": {
            "required": [
              "decision_policy",
              "rotation_seed"
            ],
            "properties": {
              "assumptions": {
                "required": [
                  "no_order_or_carryover"
                ]
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "decision_policy"
                  ]
                },
                {
                  "required": [
                    "rotation_seed"
                  ]
                }
              ]
            },
            "properties": {
              "allocation": {
                "enum": [
                  "adaptive_frontier",
                  "uniform_all"
                ]
              },
              "assumptions": {
                "not": {
                  "required": [
                    "no_order_or_carryover"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_sha256",
        "history_sha256",
        "index",
        "candidate_ids",
        "unit_ids",
        "planned_candidate_units",
        "planned_runs",
        "reserved_micros"
      ],
      "properties": {
        "protocol_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "history_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "candidate_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "unit_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "planned_candidate_units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "planned_runs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 81920000
        },
        "reserved_micros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000000000000
        },
        "execution_orders": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "unit_id",
              "candidate_ids"
            ],
            "properties": {
              "unit_id": {
                "type": "string"
              },
              "candidate_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 3,
                "maxItems": 32,
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "unit_id",
        "input_sha256",
        "session_id",
        "assessment_sha256",
        "utility_contract_sha256",
        "status",
        "utility",
        "cost_micros",
        "runs_started"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
        },
        "unit_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
        },
        "assessment_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "utility_contract_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "observed",
            "failed",
            "unknown"
          ]
        },
        "utility": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "cost_micros": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000000000000
        },
        "runs_started": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "execution_position": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      }
    },
    "decision_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "researcher_id",
        "loss_unit",
        "false_adoption_cost",
        "missed_use_cost",
        "time_cost_per_hour",
        "scope",
        "valid_from",
        "valid_until",
        "minimum_gain",
        "confirmation_family_floor",
        "candidates",
        "shrinkage"
      ],
      "properties": {
        "researcher_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "loss_unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "false_adoption_cost": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000.0
        },
        "missed_use_cost": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000.0
        },
        "time_cost_per_hour": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000.0
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "minimum_gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confirmation_family_floor": {
          "type": "integer",
          "minimum": 30,
          "maximum": 100000
        },
        "candidates": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "adopt_hours",
              "trial_hours",
              "evidence_hours",
              "trial_exposure",
              "trial_residual_harm",
              "guardrails",
              "prohibited",
              "prohibition_reason"
            ],
            "properties": {
              "adopt_hours": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000.0
              },
              "trial_hours": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000.0
              },
              "evidence_hours": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000.0
              },
              "trial_exposure": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "trial_residual_harm": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "guardrails": {
                "type": "array",
                "maxItems": 30,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "prohibited": {
                "type": "boolean"
              },
              "prohibition_reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "shrinkage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target",
            "strength",
            "rationale"
          ],
          "properties": {
            "target": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "strength": {
              "type": "number",
              "minimum": 1e-08,
              "maximum": 100000
            },
            "rationale": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "protocol": {
            "properties": {
              "format": {
                "const": "pvl-risk-acquisition-1"
              }
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "confirmation_studies"
          ]
        }
      }
    }
  ]
}
