{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plugin-value-lab.local/schemas/science/metamorphic-design-1",
  "title": "PVL scientific metamorphic design v1",
  "type": "object", "additionalProperties": false,
  "required": ["format", "source", "output", "tolerance", "relations"],
  "properties": {
    "format": {"const": "pvl-metamorphic-design-1"},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["matrix", "context"],
      "properties": {"matrix": {"$ref": "#/$defs/matrix"}, "context": {"type": "object"}}
    },
    "output": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["kind", "row_ids", "columns"], "properties": {
        "kind": {"const": "numeric"}, "row_ids": {"$ref": "#/$defs/ids"}, "columns": {"$ref": "#/$defs/ids"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "row_ids"], "properties": {
        "kind": {"const": "partition"}, "row_ids": {"$ref": "#/$defs/ids"}}}
    ]},
    "tolerance": {"type": "object", "additionalProperties": false, "required": ["absolute", "relative"], "properties": {
      "absolute": {"type": "number", "minimum": 0, "maximum": 0.0001}, "relative": {"type": "number", "minimum": 0, "maximum": 0.0001}}},
    "relations": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/relation"}}
  },
  "$defs": {
    "ids": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "matrix": {"type": "object", "additionalProperties": false, "required": ["row_ids", "columns", "values"], "properties": {
      "row_ids": {"$ref": "#/$defs/ids"}, "columns": {"$ref": "#/$defs/ids"},
      "values": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"type": "number"}}}
    }},
    "relation": {
      "type": "object", "additionalProperties": false, "required": ["id", "relation", "parameters", "rationale"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$", "not": {"const": "baseline"}},
        "relation": {"enum": ["row_permutation", "feature_permutation", "positive_scale", "partition_invariance", "contrast_reversal"]},
        "parameters": {"type": "object"}, "rationale": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"relation": {"enum": ["row_permutation", "feature_permutation", "partition_invariance"]}}},
         "then": {"properties": {"parameters": {"type": "object", "additionalProperties": false, "required": ["order"], "properties": {"order": {"$ref": "#/$defs/ids"}}}}}},
        {"if": {"properties": {"relation": {"const": "positive_scale"}}},
         "then": {"properties": {"parameters": {"type": "object", "additionalProperties": false, "required": ["columns", "factor", "output_factors"], "properties": {
           "columns": {"$ref": "#/$defs/ids"}, "factor": {"type": "number", "minimum": 0.001, "maximum": 1000, "not": {"const": 1}},
           "output_factors": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number", "minimum": 0.000001, "maximum": 1000000}}
         }}}}},
        {"if": {"properties": {"relation": {"const": "contrast_reversal"}}},
         "then": {"properties": {"parameters": {"type": "object", "additionalProperties": false, "required": ["effect", "standard_error", "ci_lower", "ci_upper", "p_value", "q_value"], "properties": {
           "effect": {"type": "string"}, "standard_error": {"type": "string"}, "ci_lower": {"type": "string"}, "ci_upper": {"type": "string"}, "p_value": {"type": "string"}, "q_value": {"type": "string"}
         }}}}}
      ]
    }
  },
  "$comment": "Runtime validation additionally enforces finite values, dimensions, exact identity coverage, scientific preconditions and nontrivial transformations. Schema validity is not scientific validity."
}
