{
  "format": "pvl-metamorphic-design-1",
  "source": {
    "matrix": {"row_ids": ["sample-a", "sample-b", "sample-c"], "columns": ["gene-x", "gene-y"], "values": [[1, 2], [3, 6], [8, 13]]},
    "context": {"method": "column_sum", "origin": "manufactured_calibration"}
  },
  "output": {"kind": "numeric", "row_ids": ["sum"], "columns": ["gene-x", "gene-y"]},
  "tolerance": {"absolute": 1e-9, "relative": 1e-8},
  "relations": [
    {"id": "row-order", "relation": "row_permutation", "parameters": {"order": ["sample-c", "sample-a", "sample-b"]}, "rationale": "Column sums do not depend on the order of samples."},
    {"id": "feature-order", "relation": "feature_permutation", "parameters": {"order": ["gene-y", "gene-x"]}, "rationale": "Column sums must follow feature identities rather than positional headers."},
    {"id": "scale-x", "relation": "positive_scale", "parameters": {"columns": ["gene-x"], "factor": 2, "output_factors": {"gene-x": 2, "gene-y": 1}}, "rationale": "Sum is linear in the scaled column; the other column remains unchanged."}
  ]
}
