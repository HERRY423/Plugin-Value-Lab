    "name": "example-plugin",
    "version": "0.0.0-demo"
  },
  "evidence_type": "synthetic",
  "runs_per_case": 1,
  "conditions": {
    "model": "SYNTHETIC-MODEL-1",
    "host": "codex",
    "tools": [],
