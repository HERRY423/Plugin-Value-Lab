      "kind": "task",
      "prompt": "Deliver a task result with a source reference and explicit limitations.",
      "graders": [
        {
          "id": "source",
          "type": "contains",
          "value": "SOURCE:",
          "weight": 1,
          "critical": false,
          "dimension": "outcome"
        },
        {
          "id": "limits",
          "type": "contains",
          "value": "LIMITS:",
          "weight": 1,
          "critical": false,
          "dimension": "outcome"
        }
      ]
    }
  ]
}
